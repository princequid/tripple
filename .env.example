# Copy to .env.local. Never commit real values. Every variable is validated in src/server/env.ts.
# Database (Turso). Local development uses a libSQL file.
DATABASE_URL=file:.data/local.db
DATABASE_AUTH_TOKEN=
# Better Auth
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in (optional until the OAuth client exists, B-16)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email: "outbox" (dev/test only: writes codes to .data/outbox.jsonl) or "resend" (needs RESEND_API_KEY)
EMAIL_TRANSPORT=outbox
RESEND_API_KEY=
EMAIL_FROM=Trippple <no-reply@example.com>
# Media (A-19): "local" serves pre-rendered seed files from /seed-media; "imagekit" serves originals from ImageKit
# with on-the-fly transformations. Production requires imagekit + the https URL endpoint (https://ik.imagekit.io/neoxxetjv).
NEXT_PUBLIC_MEDIA_PROVIDER=local
NEXT_PUBLIC_MEDIA_BASE_URL=/seed-media
# ImageKit API keys: only needed for uploads (release R2). Never expose the private key to the client.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Secrets for HMACs and internal endpoints
VIEW_HMAC_SECRET=change-me
CURSOR_HMAC_SECRET=change-me
CRON_SECRET=change-me
INTERNAL_SECRET=change-me
